{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "title",
    "summary",
    "product_type",
    "publication_status",
    "coverage",
    "temporal",
    "indicator",
    "data_sources",
    "method",
    "limitations",
    "validation",
    "outputs",
    "license",
    "governance",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "product_type": {
      "enum": [
        "mapa",
        "indicador",
        "visor",
        "datos",
        "metodo",
        "documentacion"
      ]
    },
    "publication_status": {
      "enum": [
        "propuesto",
        "en_preparacion",
        "publicado",
        "retirado"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "geometry_url",
        "spatial_resolution",
        "scale_denominator"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "geometry_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "spatial_resolution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scale_denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "reference_date"
      ],
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "definition",
        "aggregation"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "definition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "aggregation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "provider",
          "url",
          "access",
          "description",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "access": {
            "enum": [
              "abierto",
              "institucional",
              "restringido",
              "por_confirmar"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "enum": [
              "declarado",
              "propuesta",
              "por_confirmar"
            ]
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "version",
        "code_url"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "code_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence_url",
        "date",
        "reviewer"
      ],
      "properties": {
        "state": {
          "enum": [
            "pendiente",
            "en_revision",
            "validado",
            "con_observaciones",
            "no_validado"
          ]
        },
        "evidence_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "validado",
                  "con_observaciones",
                  "no_validado"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewer_url",
        "download_url",
        "documentation_url",
        "thumbnail_url"
      ],
      "properties": {
        "viewer_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "download_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "documentation_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "reuse_note"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "reuse_note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution",
        "maintainer",
        "update_frequency",
        "content_updated_at"
      ],
      "properties": {
        "institution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "maintainer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "update_frequency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "statements"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "locator",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 1
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "status",
              "source_ids",
              "note"
            ],
            "properties": {
              "pointer": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "declarado",
                  "propuesta",
                  "por_confirmar"
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:copernicus:urbano:atlas-product:1.0.0",
  "title": "Metadatos de una contribución al Atlas Urbano Regional",
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_status": {
            "const": "publicado"
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "anyOf": [
              {
                "properties": {
                  "viewer_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  }
                }
              },
              {
                "properties": {
                  "download_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  }
                }
              },
              {
                "properties": {
                  "documentation_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  }
                }
              }
            ]
          },
          "governance": {
            "properties": {
              "institution": {
                "type": "string",
                "minLength": 1
              },
              "maintainer": {
                "type": "string",
                "minLength": 1
              },
              "content_updated_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  ]
}
